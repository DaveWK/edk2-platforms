[Defines]
  INF_VERSION    = 0x0001001C
  BASE_NAME      = RtPropertiesDxe
  FILE_GUID      = 0a769b1c-5b3a-4bd3-ab34-a4106d99812b
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = RtPropertiesDxeInitialize

[Sources]
  RtPropertiesDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  DebugLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gEfiRtPropertiesTableGuid             ## PRODUCES ## SystemTable

[Depex]
  TRUE
