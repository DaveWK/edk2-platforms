## @file
#  NonDiscoverableRegistrationDxe - register the board's MMIO host
#  controllers (NonDiscoverableDeviceTableLib) as EDKII non-discoverable
#  devices for the upstream SdMmcPciHcDxe, XhciDxe and EhciDxe; only those
#  oreboot reports ready when PcdNonDiscoverableReadyProperty is set.
#  Moved from the Radxa Cubie A7A's SunxiUsbDxe.
#
#  Copyright (c) 2026, carpi-os contributors.
#  Copyright (c) 2026, radxa-a7a oreboot/EDK2 contributors.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = NonDiscoverableRegistrationDxe
  FILE_GUID      = 7E3D1F2C-9A4B-4C5D-8E6F-1B2C3D4E5F60
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = NonDiscoverableRegistrationEntry

[Sources]
  NonDiscoverableRegistrationDxe.c

[Packages]
  EmbeddedPkg/EmbeddedPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  OreEdk2BootPkg/OreEdk2BootPkg.dec

[LibraryClasses]
  DebugLib
  FdtLib
  HobLib
  NonDiscoverableDeviceRegistrationLib
  NonDiscoverableDeviceTableLib
  PcdLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gFdtHobGuid                           ## CONSUMES ## HOB

[Pcd]
  gOreEdk2BootTokenSpaceGuid.PcdNonDiscoverableReadyNode
  gOreEdk2BootTokenSpaceGuid.PcdNonDiscoverableReadyProperty

[Depex]
  TRUE
