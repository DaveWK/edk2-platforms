[Defines]
  DEC_SPECIFICATION              = 0x00010019
  PACKAGE_NAME                   = DesignWarePkg
  PACKAGE_GUID                   = 36a7fa33-7843-4e05-afc6-0d943660f47d
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Protocols.common]
  gDwcEqosPlatformDeviceProtocolGuid = { 0x734fd3dd, 0xe30d, 0x4ee4, { 0xbc, 0x8e, 0x83, 0xfc, 0xc0, 0xa1, 0xc5, 0x85 } }
